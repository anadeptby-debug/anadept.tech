---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import PageTop from '../components/PageTop.astro';
import Services from '../components/Services.astro';
import WorkSteps from '../components/WorkSteps.astro';
import Audit from '../components/Audit.astro';
import Solutions from '../components/Solutions.astro';
import How from '../components/How.astro';
import Trust from '../components/Trust.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeCases from '../components/HomeCases.astro';
import HomeSteps from '../components/HomeSteps.astro';
import HomeWhy from '../components/HomeWhy.astro';
import DemoHow from '../components/DemoHow.astro';
import { lurl } from '../lib/url';
import RealCases from '../components/RealCases.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { cases, caseLabels, type CaseStudy as CaseData } from '../i18n/cases';
import ServiceDetail from '../components/ServiceDetail.astro';
import { services, serviceLabels } from '../i18n/services';
import { dict, type Lang } from '../i18n/content';

// Все страницы сайта на двух языках: RU без префикса, EN под /en/
export function getStaticPaths() {
  const pages = ['', 'services', 'cases', 'demo', 'process', 'about', 'contact', ...cases.ru.map((c) => `cases/${c.slug}`), ...services.ru.map((s) => `services/${s.slug}`)];
  return (['ru', 'en'] as const).flatMap((lang) =>
    pages.map((page) => ({
      params: { slug: [lang === 'en' ? 'en' : '', page].filter(Boolean).join('/') || undefined },
      props: { lang, page },
    })),
  );
}

const { lang, page } = Astro.props as { lang: Lang; page: string };
const t = dict[lang];
const cs: CaseData | undefined = page.startsWith('cases/') ? cases[lang].find((c) => `cases/${c.slug}` === page) : undefined;
const cl = caseLabels[lang];
const si = page.startsWith('services/') ? services[lang].findIndex((s) => `services/${s.slug}` === page) : -1;
const svc = si >= 0 ? { ...services[lang][si], name: t.services.items[si].t } : undefined;
const sl = serviceLabels[lang];
---
<Page lang={lang} page={page} title={cs?.card.title ?? svc?.name}>
  {/* Главная: короткие версии разделов, «подробнее» ведёт на отдельные страницы */}
  {page === '' && <Hero slot="top" t={t} lang={lang} />}
  {page === '' && (
    <>
      <HomeServices t={t} lang={lang} />
      <HomeCases t={t} lang={lang} />
      <Audit t={t} lang={lang} more={{ href: lurl(lang, '/demo/'), label: t.home.demo.more }} />
      <HomeSteps t={t} lang={lang} />
      <HomeWhy t={t} lang={lang} />
      <Faq t={t} limit={4} title={t.home.faq.title} more={{ href: lurl(lang, '/about/#faq'), label: t.home.faq.more }} />
      <Contact t={t} title={t.home.contact.title} />
    </>
  )}

  {page === 'services' && <PageTop slot="top" eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} />}
  {page === 'services' && (
    <>
      <Services t={t} lang={lang} />
      <WorkSteps t={t} />
    </>
  )}

  {page === 'demo' && <PageTop slot="top" eyebrow={t.audit.eyebrow} title={t.demoPage.title} lead={t.demoPage.lead} />}
  {page === 'demo' && (
    <>
      <Audit t={t} lang={lang} bare />
      <DemoHow t={t} />
    </>
  )}

  {page === 'cases' && <PageTop slot="top" eyebrow={cl.eyebrow} title={cl.pageTitle} lead={cl.pageLead} />}
  {page === 'cases' && (<><RealCases lang={lang} /><Solutions t={t} /></>)}

  {cs && <PageTop slot="top" eyebrow={`${cl.case} · ${cs.tag}`} title={cs.title} lead={cs.lead} meta={cs.meta} back={{ href: lurl(lang, '/cases/'), label: cl.allCases }} />}
  {cs && <CaseStudy c={cs} lang={lang} />}

  {svc && <PageTop slot="top" eyebrow={sl.eyebrow} title={svc.name} lead={svc.lead} back={{ href: lurl(lang, '/services/'), label: sl.back }} />}
  {svc && <ServiceDetail t={t} lang={lang} i={si} />}
  {page === 'process' && <How t={t} lang={lang} />}
  {page === 'about' && (<><Trust t={t} /><Faq t={t} /></>)}
  {page === 'contact' && <Contact t={t} />}
</Page>
