---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const h = t.hero;
---
<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-txt">
      <h1>
        {h.title.map((line, i) => (
          <span class="line"><span class="line-in" style={`--d:${i * 0.12}s`} set:html={line} /></span>
        ))}
      </h1>
      <p class="lead reveal">{h.lead}</p>
      <div class="hero-cta reveal">
        <a href="#contact" class="btn" data-magnetic data-cursor={h.cursorCta}>{h.cta}<span class="arr">→</span></a>
        <a href="#demo" class="link">{h.cta2} <span>↓</span></a>
      </div>
      <ul class="facts reveal">
        {h.trust.map((x) => <li><span class="ck">✓</span>{x}</li>)}
      </ul>
    </div>

    <div class="log reveal">
      <div class="log-top mono"><span>{h.logTitle}</span><span class="dot live"></span></div>
      <ol class="log-rows mono">
        {h.log.map((r) => (
          <li class={r.k}>
            <span class="ts">{r.t}</span>
            <span class="mark">{r.k === 'warn' ? '!' : r.k === 'in' ? '↓' : '✓'}</span>
            <span class="a">{r.a}</span>
            <span class="s">{r.s}</span>
          </li>
        ))}
      </ol>
      <div class="measure mono">
        <span class="m-l">{h.measure.label}</span>
        <span class="m-b">{h.measure.before}</span>
        <span class="m-arr">→</span>
        <span class="m-a">{h.measure.after}</span>
      </div>
    </div>
  </div>
  <div class="wrap"><p class="tools mono reveal">{h.tools}</p></div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  hero.addEventListener('mousemove', (e) => {
    const r = hero.getBoundingClientRect();
    hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
    hero.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
  const rows = [...document.querySelectorAll<HTMLElement>('.log-rows li')];
  const m = document.querySelector<HTMLElement>('.measure')!;
  let k = 0;
  const tick = () => {
    rows.forEach((li, i) => li.classList.toggle('on', i < k));
    m.classList.toggle('on', k >= rows.length);
    k = k > rows.length + 2 ? 0 : k + 1;
  };
  tick(); setInterval(tick, 900);
</script>

<style>
  .hero { padding-top: clamp(56px, 8vw, 120px); padding-bottom: 0; overflow: hidden; --mx: 70%; --my: 40%; }
  .glow {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(520px circle at var(--mx) var(--my), color-mix(in oklab, var(--accent) 10%, transparent), transparent 60%);
    /* плавно гасим подсветку к краям блока — без резкой границы */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 92%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 92%);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(40px, 6vw, 96px); align-items: center; position: relative; }
  .hero-txt { display: grid; gap: 32px; justify-items: start; }
  h1 { display: grid; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; }
  .line-in { display: block; transform: translateY(105%); animation: up 1s var(--ease) forwards; animation-delay: var(--d); }
  .line-in :global(em) { color: var(--accent); font-size: 1.04em; }
  @keyframes up { to { transform: none; } }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .link { font-weight: 500; border-bottom: 1px solid var(--line-2); padding-bottom: 2px; transition: border-color .2s; }
  .link:hover { border-color: var(--ink); }
  .link span { color: var(--accent); }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 15px; color: var(--ink-2); }
  .facts li { display: flex; gap: 8px; align-items: center; }
  .ck { color: var(--accent); font-weight: 600; }

  .log { background: var(--ink); color: #d9d5cd; border-radius: 18px; padding: 22px 22px 24px; box-shadow: 0 30px 60px -30px rgba(30,20,10,.45); display: flex; flex-direction: column; min-height: 500px; }
  .log-top { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #8b877f; padding-bottom: 14px; border-bottom: 1px dashed #3a3a3c; margin-bottom: 8px; }
  .log-rows { list-style: none; margin: 0; padding: 0; display: grid; align-content: start; gap: 0; font-size: 13px; flex: 1; }
  .log-rows li { display: grid; grid-template-columns: 64px 14px 1fr; grid-template-rows: auto auto; column-gap: 8px; row-gap: 2px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid #2a2a2c; opacity: .22; transition: opacity .4s; }
  .log-rows li .s { grid-column: 3; text-align: left; font-size: 12px; }
  .log-rows li.on { opacity: 1; }
  .ts { color: #6f6b64; }
  .mark { color: #7fc79f; }
  .warn .mark, .warn .s { color: var(--accent); }
  .in .mark { color: #8b877f; }
  .a { color: var(--milk); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .s { color: #8b877f; text-align: right; }
  .measure { margin-top: auto; padding-top: 14px; border-top: 1px dashed #3a3a3c; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; opacity: .25; transition: opacity .5s; }
  .measure.on { opacity: 1; }
  .m-l { flex-basis: 100%; font-size: 12px; color: #8b877f; text-transform: uppercase; }
  .m-b, .m-a { white-space: nowrap; }
  .m-b { font-size: 20px; color: #8b877f; text-decoration: line-through; text-decoration-color: var(--accent); }
  .m-arr { color: #6f6b64; }
  .m-a { font-size: 28px; color: var(--accent); font-weight: 500; }
  .tools { margin-top: clamp(48px, 6vw, 72px); font-size: 13px; color: var(--muted); padding-top: 20px; border-top: 1px solid var(--line-2); }

  @media (max-width: 920px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 920px) { .log { min-height: 0; } }
</style>
