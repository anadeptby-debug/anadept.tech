---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const h = t.hero;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <p class="eyebrow">{h.eyebrow}</p>
    <h1 id="hero-title">{h.title.map((l) => <span>{l}</span>)}</h1>
    <p class="description">{h.lead}</p>
    <div class="actions">
      <a class="btn-outline" href="#services">{h.cta2}</a>
      <a class="btn-split" href="#contact">
        <span class="bs-label">{h.cta}</span>
        <span class="bs-arrow" aria-hidden="true"><i></i></span>
      </a>
    </div>
    <ul class="benefits">
      {h.benefits.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<section class="strip" aria-labelledby="strip-title">
  <div class="strip-inner">
    <h2 id="strip-title" set:html={h.strip.title} />
    <ul class="strip-list">
      {h.strip.items.map((it, i) => (
        <li><button type="button" data-svc={i}>{it.t}</button></li>
      ))}
    </ul>
  </div>
</section>

<dialog class="svc-dialog" data-items={JSON.stringify(h.strip.items)}>
  <form method="dialog"><button class="svc-close" aria-label={h.strip.close} value="close">×</button></form>
  <h2 class="svc-title"></h2>
  <p class="svc-desc"></p>
  <a href="#contact" class="btn svc-cta">{h.cta}</a>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.svc-dialog')!;
  const items = JSON.parse(dlg.dataset.items!) as { t: string; d: string }[];
  document.querySelectorAll<HTMLButtonElement>('[data-svc]').forEach((b) => b.addEventListener('click', () => {
    const it = items[Number(b.dataset.svc)];
    dlg.querySelector('.svc-title')!.textContent = it.t;
    dlg.querySelector('.svc-desc')!.textContent = it.d;
    dlg.showModal();
  }));
  dlg.querySelector('.svc-cta')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  /* Первый экран — один в один с макетом */
  .hero { padding: 158px 24px 148px; text-align: center; background: var(--dark); color: var(--on-dark); }
  .hero-inner { max-width: 1100px; margin-inline: auto; }
  .eyebrow { justify-content: center; min-height: 24px; color: #c7cad3; line-height: 1.45; }
  h1 { margin: 20px 0 0; font-family: 'Onest', sans-serif; font-size: clamp(54px, 7vw, 92px); font-weight: 500; line-height: 1; letter-spacing: -.035em; }
  h1 span { display: block; }
  .description { max-width: 680px; margin: 12px auto 0; font-family: 'Wix Madefor Display', sans-serif; font-size: 18px; line-height: 28px; letter-spacing: .035em; text-wrap: balance; }
  .actions { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 31px; }
  .btn-outline {
    display: inline-flex; align-items: center; justify-content: center; min-width: 174px; min-height: 50px; padding: 0 32px;
    border-radius: 999px; border: 1px solid #c7cad3; font-size: 14px; font-weight: 500; white-space: nowrap; transition: background-color .16s;
  }
  .btn-outline:hover { background: #ffffff15; }
  .benefits { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 3px 14px; margin: 20px 0 0; padding: 0; list-style: none; color: var(--on-dark-muted); font-size: 13px; line-height: 24px; }
  .benefits li::before { content: '✓'; margin-right: 5px; }

  /* Белая панель «Что мы делаем» со скруглением сверху */
  .strip { background: var(--dark); padding: 0; }
  .strip-inner {
    border-radius: 72px 72px 0 0; background: #fff; color: var(--dark);
    padding: 76px 32px 78px; display: flex; align-items: center; gap: 64px;
  }
  .strip-inner > * { max-width: 1110px; }
  .strip-inner { justify-content: center; }
  .strip h2 { margin: 0; flex: none; font-family: var(--font); font-size: 15px; font-weight: 500; line-height: 24px; letter-spacing: 0; }
  .strip-list { display: grid; grid-template-columns: repeat(5, minmax(0, auto)); justify-content: space-between; align-items: center; gap: 16px; width: 100%; max-width: 980px; margin: 0; padding: 0; list-style: none; }
  .strip-list button { min-height: 44px; padding: 0; border: 0; background: transparent; color: #343943; font-family: 'Onest', sans-serif; font-size: clamp(16px, 1.55vw, 22px); font-weight: 600; letter-spacing: -.035em; text-align: left; cursor: pointer; transition: color .16s; }
  .strip-list button:hover { color: #ab3e20; }

  .svc-dialog { width: min(480px, calc(100% - 32px)); max-height: calc(100% - 32px); padding: 35px; border: 0; border-radius: 24px; background: #fff; color: var(--dark); }
  .svc-dialog::backdrop { background: #090d18b8; }
  .svc-dialog h2 { margin: 0 28px 12px 0; font: 500 32px/1.15 'Onest', sans-serif; letter-spacing: -.035em; }
  .svc-dialog p { margin: 0 0 20px; line-height: 1.6; }
  .svc-close { position: absolute; top: 13px; right: 14px; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 50%; background: #edf0f4; color: var(--dark); font-size: 24px; cursor: pointer; }
  .svc-cta { min-height: 44px; padding: 0 21px; }

  @media (max-width: 900px) {
    .strip-inner { gap: 32px; }
    .strip-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .hero { padding: 118px 18px 86px; }
    h1 { font-size: clamp(34px, 7.5vw, 54px); line-height: 1.05; }
    .eyebrow { font-size: 11px; }
    .description { max-width: 490px; margin-top: 17px; font-size: 15px; line-height: 24px; letter-spacing: .015em; }
    .actions { margin-top: 27px; gap: 11px; }
    .btn-outline { min-width: 0; min-height: 44px; padding-inline: 18px; font-size: 12px; }
    .actions :global(.btn-split) { font-size: 13px; gap: 4px; }
    .actions :global(.btn-split .bs-label) { min-width: 0; height: 44px; padding-inline: 16px; }
    .actions :global(.btn-split .bs-arrow) { width: 44px; height: 44px; }
    .benefits { margin-top: 18px; font-size: 11px; gap: 2px 10px; }
    .strip-inner { padding: 36px 22px 42px; border-radius: 36px 36px 0 0; display: block; }
    .strip h2 { margin-bottom: 12px; }
    .strip h2 :global(br) { display: none; }
    .strip-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 10px; row-gap: 0; }
  }
  @media (max-width: 360px) {
    h1 { font-size: clamp(28px, 8.6vw, 31px); }
    .btn-outline { padding-inline: 14px; }
    .actions :global(.btn-split .bs-label) { padding-inline: 12px; }
    .actions :global(.btn-split .bs-arrow) { width: 40px; }
    .svc-dialog { padding: 24px; }
  }
</style>
