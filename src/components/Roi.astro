---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const r = t.roi;
const sliders = [
  { k: 'people', label: r.people, min: 1, max: 20, step: 1, v: 3, suf: '' },
  { k: 'hours', label: r.hours, min: 0.5, max: 6, step: 0.5, v: 2, suf: '' },
  { k: 'rate', label: r.rate, min: 8, max: 60, step: 1, v: 18, suf: '' },
  { k: 'share', label: r.share, min: 20, max: 80, step: 5, v: 50, suf: '%' },
];
---
<section class="roi">
  <div class="wrap roi-grid">
    <div class="sec-head reveal">
      <span class="eyebrow">{r.eyebrow}</span>
      <h2>{r.title}</h2>
      <p class="note">{r.note}</p>
    </div>
    <div class="calc card reveal" data-roi>
      <div class="sliders">
        {sliders.map((s) => (
          <label class="sl">
            <span class="sl-top"><span>{s.label}</span><output data-o={s.k}>{s.v}{s.suf}</output></span>
            <input type="range" min={s.min} max={s.max} step={s.step} value={s.v} data-k={s.k} data-suf={s.suf} />
          </label>
        ))}
      </div>
      <div class="sum">
        <div class="big"><b data-out="month">0</b><span>BYN {r.month}</span></div>
        <div class="row">
          <div><b data-out="year">0</b><span>BYN {r.year}</span></div>
          <div><b data-out="payback">0</b><span>{r.months} — {r.payback}</span></div>
        </div>
        <a href="#contact" class="btn accent" data-magnetic>{r.cta}<span class="arr">→</span></a>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-roi]')!;
  const inputs = [...root.querySelectorAll<HTMLInputElement>('input[type=range]')];
  const fmt = (n: number) => Math.round(n).toLocaleString('ru-RU').replace(/,/g, ' ');
  const PILOT = 2500;
  const calc = () => {
    const v: Record<string, number> = {};
    inputs.forEach((i) => {
      v[i.dataset.k!] = +i.value;
      root.querySelector(`[data-o=${i.dataset.k}]`)!.textContent = i.value + (i.dataset.suf || '');
      const p = ((+i.value - +i.min) / (+i.max - +i.min)) * 100;
      i.style.setProperty('--p', `${p}%`);
    });
    const month = v.people * v.hours * 21 * v.rate * (v.share / 100);
    root.querySelector('[data-out=month]')!.textContent = fmt(month);
    root.querySelector('[data-out=year]')!.textContent = fmt(month * 12);
    root.querySelector('[data-out=payback]')!.textContent = month > 0 ? (PILOT / month).toFixed(1) : '—';
  };
  inputs.forEach((i) => i.addEventListener('input', calc));
  calc();
</script>

<style>
  .roi { background: var(--milk-2); }
  .roi-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
  .note { font-size: 14px; color: var(--muted); }
  .calc { display: grid; grid-template-columns: 1fr 1fr; border-radius: var(--radius-l); overflow: hidden; }
  .sliders { padding: 32px; display: grid; gap: 28px; }
  .sl { display: grid; gap: 12px; }
  .sl-top { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; color: var(--ink-2); }
  .sl-top output { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  input[type=range] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 4px; outline: none;
    background: linear-gradient(to right, var(--ink) var(--p, 50%), var(--line-2) var(--p, 50%));
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--paper);
    border: 2px solid var(--ink); box-shadow: 0 2px 8px rgba(0,0,0,.12); transition: transform .2s;
  }
  input[type=range]:active::-webkit-slider-thumb { transform: scale(1.2); }
  input[type=range]::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: var(--paper); border: 2px solid var(--ink); }
  .sum { background: var(--ink); color: var(--milk); padding: 32px; display: grid; gap: 24px; align-content: space-between; }
  .sum span { color: #a5a29b; font-size: 14px; display: block; }
  .big b { font-size: clamp(48px, 6vw, 76px); font-weight: 500; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; border-top: 1px solid #333; padding-top: 20px; }
  .row b { font-size: 26px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .sum .btn { justify-self: start; }
  @media (max-width: 920px) { .roi-grid, .calc { grid-template-columns: 1fr; } }
</style>
