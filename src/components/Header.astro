---
import type { Dict } from '../i18n/content';
import { url } from '../lib/url';
const { t } = Astro.props as { t: Dict };
const home = url(t.nav.other.href === '/' ? '/en/' : '/');
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href={home} class="logo">anadept<span class="logo-dot"></span></a>
    <nav class="nav">
      {t.nav.links.map((l) => <a href={l.href} data-nav={l.href.slice(1)}>{l.label}</a>)}
    </nav>
    <div class="hdr-r">
      <a href={url(t.nav.other.href)} class="lang">{t.nav.other.label}</a>
      <a href="#contact" class="btn hdr-cta" data-magnetic>{t.nav.cta}<span class="arr">→</span></a>
      <button type="button" class="burger" aria-label="Menu" aria-expanded="false"><i></i><i></i></button>
    </div>
  </div>
  <nav class="m-nav" aria-hidden="true">
    <div class="wrap">
      {t.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </nav>
</header>

<a href="#contact" class="m-cta btn">{t.hero.cta}<span class="arr">→</span></a>

<script>
  const h = document.querySelector<HTMLElement>('.hdr')!;
  const mcta = document.querySelector('.m-cta')!;
  const contact = document.getElementById('contact');
  const on = () => {
    h.classList.toggle('scrolled', scrollY > 10);
    const nearContact = contact ? contact.getBoundingClientRect().top < innerHeight : false;
    mcta.classList.toggle('show', scrollY > innerHeight * 0.8 && !nearContact && !h.classList.contains('open'));
  };
  addEventListener('scroll', on, { passive: true }); on();

  // Mobile menu
  const burger = h.querySelector<HTMLButtonElement>('.burger')!;
  const setOpen = (v: boolean) => {
    h.classList.toggle('open', v);
    burger.setAttribute('aria-expanded', String(v));
    h.querySelector('.m-nav')!.setAttribute('aria-hidden', String(!v));
    on();
  };
  burger.addEventListener('click', () => setOpen(!h.classList.contains('open')));
  h.querySelectorAll('.m-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Highlight the current section
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) links.forEach((l) => l.classList.toggle('cur', l.dataset.nav === e.target.id));
  }), { rootMargin: '-45% 0px -50% 0px' });
  links.forEach((l) => { const s = document.getElementById(l.dataset.nav!); if (s) io.observe(s); });
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 40; transition: background .3s, border-color .3s; border-bottom: 1px solid transparent; }
  .hdr.scrolled, .hdr.open { background: color-mix(in oklab, var(--milk) 88%, transparent); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); border-color: var(--line); }
  .hdr-in { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 20px; }
  .logo { font-weight: 600; font-size: 22px; letter-spacing: -0.04em; display: inline-flex; align-items: flex-end; gap: 2px; }
  .logo-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); margin-bottom: 6px; }
  .nav { display: flex; gap: 2px; font-size: 15px; }
  .nav a { padding: 8px 12px; border-radius: 8px; color: var(--ink-2); transition: background .2s, color .2s; }
  .nav a:hover { background: var(--milk-2); }
  .nav a.cur { background: var(--paper); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); }
  .hdr-r { display: flex; align-items: center; gap: 14px; }
  .lang { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .lang:hover { color: var(--ink); }
  .hdr-cta { padding: 11px 18px; font-size: 15px; }

  .burger { display: none; width: 42px; height: 42px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--paper); cursor: pointer; position: relative; }
  .burger i { position: absolute; left: 11px; right: 11px; height: 1.5px; background: var(--ink); transition: transform .3s var(--ease), top .3s var(--ease); }
  .burger i:first-child { top: 16px; } .burger i:last-child { top: 24px; }
  .open .burger i:first-child { top: 20px; transform: rotate(45deg); }
  .open .burger i:last-child { top: 20px; transform: rotate(-45deg); }

  .m-nav { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s var(--ease); }
  .m-nav > div { overflow: hidden; display: grid; width: 100%; min-height: 0; }
  .m-nav a { padding: 14px 0; border-top: 1px solid var(--line); font-size: 20px; font-family: var(--font-head); font-weight: var(--head-w); letter-spacing: -0.01em; word-spacing: .1em; }
  .m-nav a:last-child { margin-bottom: 16px; }
  .open .m-nav { grid-template-rows: 1fr; }

  .m-cta { display: none; }
  @media (min-width: 1081px) { .m-nav { display: none; } }
  @media (max-width: 1080px) {
    .nav { display: none; }
    .burger { display: block; }
  }
  @media (max-width: 920px) {
    .m-cta {
      display: flex; justify-content: center; position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 45;
      box-shadow: 0 12px 30px -10px rgba(0,0,0,.4); transform: translateY(140%); transition: transform .4s var(--ease);
    }
    .m-cta.show { transform: none; }
  }
  @media (max-width: 480px) { .hdr-cta { display: none; } }
</style>
