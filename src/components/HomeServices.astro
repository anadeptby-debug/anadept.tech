---
import type { Dict, Lang } from '../i18n/content';
import { lurl } from '../lib/url';
import HomeHead from './HomeHead.astro';
import { services as details } from '../i18n/services';
const { t, lang } = Astro.props as { t: Dict; lang: Lang };
const h = t.home.services;
const href = lurl(lang, '/services/');
---
<section class="h-svc" id="services">
  <div class="wrap">
    <HomeHead eyebrow={h.eyebrow} title={h.title} lead={h.lead} href={href} more={h.more} />
    <div class="grid">
      {t.services.items.map((it, i) => (
        <a href={lurl(lang, `/services/${details[lang][i].slug}/`)} class="svc reveal" style={`transition-delay:${(i % 3) * 70}ms`} data-cursor={t.home.more}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{it.t}</h3>
          <p>{it.d}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .svc {
    display: grid; align-content: start; gap: 12px; padding: 28px 28px 30px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    transition: transform .4s var(--ease), box-shadow .4s, border-color .3s;
  }
  .svc:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--line-2); }
  .n { font-size: 13px; font-weight: 600; color: var(--accent); }
  .svc h3 { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.2; }
  /* На главной — коротко: три строки описания, полный текст на странице услуг */
  .svc p { color: var(--muted); font-size: 15px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .svc { padding: 24px 22px; } }
</style>
