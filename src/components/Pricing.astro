---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const p = t.pricing;
---
<section class="pricing" id="pricing" data-cur="byn">
  <div class="wrap">
    <div class="head reveal">
      <div class="sec-head">
        <span class="eyebrow">{p.eyebrow}</span>
        <h2>{p.title}</h2>
      </div>
      <div class="toggle" role="group">
        <button type="button" data-c="byn" aria-pressed="true">{p.toggle.byn}</button>
        <button type="button" data-c="rub" aria-pressed="false">{p.toggle.rub}</button>
        <span class="knob"></span>
      </div>
    </div>
    <div class="table">
      {p.rows.map((r) => (
        <div class={`row reveal${r.hot ? ' hot' : ''}`} data-cursor={r.hot ? p.hot : undefined}>
          <div class="t"><b>{r.t}</b><span>{r.d}</span></div>
          <div class="time">{r.time}</div>
          <div class="price">
            <span class="byn">{r.byn}{r.byn.match(/\d/) ? ' BYN' : ''}</span>
            <span class="rub">{r.rub}{r.rub.match(/\d/) ? ' ₽' : ''}</span>
          </div>
        </div>
      ))}
    </div>
    <p class="infra reveal">{p.infra}</p>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('.pricing')!;
  const btns = [...sec.querySelectorAll<HTMLButtonElement>('.toggle button')];
  btns.forEach((b) => b.addEventListener('click', () => {
    sec.dataset.cur = b.dataset.c!;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(40px, 6vw, 72px); }
  .head .sec-head { margin: 0; }
  .toggle { position: relative; display: inline-flex; padding: 4px; border-radius: 999px; background: var(--milk-2); border: 1px solid var(--line); }
  .toggle button { position: relative; z-index: 1; border: 0; background: none; padding: 10px 22px; font-weight: 500; cursor: pointer; transition: color .3s; }
  .knob { position: absolute; top: 4px; left: 4px; bottom: 4px; width: calc(50% - 4px); border-radius: 999px; background: var(--ink); transition: transform .4s var(--ease); }
  .toggle button[aria-pressed="true"] { color: var(--milk); }
  [data-cur="rub"] .knob { transform: translateX(100%); }
  .table { border-top: 1px solid var(--line-2); }
  .row {
    display: grid; grid-template-columns: 1fr 140px 240px; gap: 24px; align-items: center;
    padding: 26px 0; border-bottom: 1px solid var(--line-2); transition: background .3s, padding .4s var(--ease);
  }
  .row:hover { background: var(--paper); padding-inline: 20px; }
  .row.hot { background: var(--accent-soft); padding-inline: 20px; border-radius: 14px; border-bottom-color: transparent; }
  .t { display: grid; gap: 4px; }
  .t b { font-size: 20px; font-weight: 500; letter-spacing: -0.01em; }
  .t span { color: var(--muted); font-size: 15px; }
  .time { color: var(--muted); font-size: 15px; }
  .price { text-align: right; font-size: 20px; font-weight: 500; font-variant-numeric: tabular-nums; display: grid; }
  .price span { grid-area: 1 / 1; transition: opacity .3s, transform .4s var(--ease); }
  .rub { opacity: 0; transform: translateY(8px); }
  [data-cur="rub"] .rub { opacity: 1; transform: none; }
  [data-cur="rub"] .byn { opacity: 0; transform: translateY(-8px); }
  .infra { margin-top: 24px; color: var(--muted); font-size: 15px; }
  @media (max-width: 720px) {
    .row { grid-template-columns: 1fr auto; }
    .time { grid-row: 2; }
    .price { grid-row: 1 / 3; grid-column: 2; }
  }
</style>
