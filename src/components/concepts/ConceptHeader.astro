---
import { url } from '../../lib/url';

interface Props { concept: 'a' | 'b' | 'c'; }
const { concept } = Astro.props;
---
<a class="skip-link" href="#content">Перейти к содержанию</a>
<header class="ref-nav">
  <div class="concept-wrap ref-nav__inner">
    <a href={url('/')} aria-label="Anadept — главная"><img class="concept-logo" src={url('/brand/logo-white-center.png')} width="117" height="24" alt="Anadept" /></a>
    <nav class="ref-nav__links" aria-label="Навигация концепции"><a href="#services">Услуги</a><a href="#demo">Демо</a></nav>
    <div class="ref-nav__tools">
      <div class="concept-switch" aria-label="Сравнить концепции">
        <a href={url('/concepts/a')} aria-current={concept === 'a' ? 'page' : undefined}><span>A</span></a>
        <a href={url('/concepts/b')} aria-current={concept === 'b' ? 'page' : undefined}><span>B</span></a>
        <a href={url('/concepts/c')} aria-current={concept === 'c' ? 'page' : undefined}><span>C</span></a>
      </div>
      <a class="ref-nav__cta" href={url('/#contact')}>Обсудить проект</a>
      <button class="concept-nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls={`${concept}-menu`} aria-label="Открыть меню"><span></span></button>
    </div>
  </div>
  <nav class="ref-menu" id={`${concept}-menu`} data-menu-panel aria-label="Мобильная навигация">
    <a href="#services">Услуги</a><a href="#demo">Демо</a><a href={url('/#contact')}>Обсудить проект</a>
    <div class="concept-switch" aria-label="Сравнить концепции">
      <a href={url('/concepts/a')} aria-current={concept === 'a' ? 'page' : undefined}><span>A</span></a>
      <a href={url('/concepts/b')} aria-current={concept === 'b' ? 'page' : undefined}><span>B</span></a>
      <a href={url('/concepts/c')} aria-current={concept === 'c' ? 'page' : undefined}><span>C</span></a>
    </div>
  </nav>
</header>
