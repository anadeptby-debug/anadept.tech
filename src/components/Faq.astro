---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const f = t.faq;
---
<section class="faq" id="faq">
  <div class="wrap faq-grid">
    <div class="sec-head reveal">
      <span class="eyebrow">{f.eyebrow}</span>
      <h2>{f.title}</h2>
    </div>
    <div class="list">
      {f.items.map((it) => (
        <details class="reveal">
          <summary><span>{it.q}</span><i></i></summary>
          <div class="a"><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(32px, 5vw, 80px); }
  .list { border-top: 1px solid var(--line-2); }
  details { border-bottom: 1px solid var(--line-2); }
  summary {
    list-style: none; display: flex; justify-content: space-between; gap: 24px; align-items: center;
    padding: 26px 0; font-size: clamp(18px, 1.6vw, 21px); font-weight: 500; cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary i { flex: none; position: relative; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line-2); transition: background .3s, transform .4s var(--ease); }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .3s; }
  details[open] summary i { background: var(--ink); color: var(--milk); border-color: var(--ink); }
  details[open] summary i::after { transform: translate(-50%, -50%) rotate(0); }
  .a { padding: 0 56px 28px 0; color: var(--muted); }
  details[open] .a { animation: open .4s var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-6px); } }
  @media (max-width: 920px) { .faq-grid { grid-template-columns: 1fr; } .a { padding-right: 0; } }
</style>
