---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const p = t.principles;
const d = t.data;
---
<section class="principles">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2>{p.title}</h2>
    </div>
    <div class="pr">
      {p.items.map((it, i) => (
        <article class="pr-card reveal" style={`transition-delay:${i * 80}ms`}>
          <span class="pr-n">0{i + 1}</span>
          <p class="pr-q">{it.q}</p>
          <p class="pr-d">{it.d}</p>
        </article>
      ))}
    </div>
    <div class="guarantee reveal"><span class="dot"></span>{p.guarantee}</div>
  </div>
</section>

<section class="datalaw">
  <div class="wrap dl-grid">
    <div class="sec-head reveal">
      <span class="eyebrow">{d.eyebrow}</span>
      <h2>{d.title}</h2>
    </div>
    <div class="dl">
      {d.items.map((it, i) => (
        <article class="card reveal" style={`transition-delay:${i * 70}ms`}>
          <h4>{it.t}</h4>
          <p>{it.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .principles { background: var(--ink); color: var(--milk); }
  .principles .eyebrow { color: #9a9790; }
  .pr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pr-card {
    padding: 32px; border: 1px solid #333; border-radius: var(--radius); display: grid; gap: 20px; align-content: start;
    transition: border-color .3s, background .3s;
  }
  .pr-card:hover { border-color: var(--accent); background: #232325; }
  .pr-n { color: var(--accent); font-size: 14px; }
  .pr-q { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.35; letter-spacing: -0.01em; }
  .pr-d { color: #9a9790; font-size: 15px; }
  .guarantee {
    margin-top: 32px; display: inline-flex; align-items: center; gap: 12px; padding: 16px 24px;
    border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-weight: 500;
  }
  .guarantee .dot { background: var(--accent-ink); }

  .dl-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 5vw, 80px); }
  .dl { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .dl .card { padding: 26px; display: grid; gap: 10px; align-content: start; box-shadow: none; transition: transform .4s var(--ease), box-shadow .4s; }
  .dl .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .dl h4 { font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .dl p { color: var(--muted); font-size: 15px; }
  @media (max-width: 920px) { .pr, .dl-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .dl { grid-template-columns: 1fr; } }
</style>
