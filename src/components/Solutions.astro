---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const c = t.solutions;
const ru = t.nav.other.label === 'EN';
const sum = (xs: { m: number }[]) => Math.round(xs.reduce((s, x) => s + x.m, 0) * 10) / 10;
const fmt = (n: number) => (ru ? String(n).replace('.', ',') : String(n));
---
<section class="sol" id="cases">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{c.eyebrow}</span>
      <h2 set:html={c.title} />
    </div>

    <div class="tabs reveal" role="tablist">
      {c.items.map((it, i) => {
        const red = Math.round((1 - sum(it.after) / sum(it.before)) * 100);
        return (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
            <span>{it.tab}</span><span class="mono red">−{red}%</span>
          </button>
        );
      })}
    </div>

    <div class="panels reveal">
      {c.items.map((it, i) => {
        const tb = sum(it.before), ta = sum(it.after);
        return (
          <article class={`panel${i === 0 ? ' on' : ''}`} data-panel={i}>
            <div class="p-l">
              <span class="tagline">{it.tag}</span>
              <h3>{it.title}</h3>
              <div class="metrics">
                <div><b class="mono"><s>{fmt(tb)}</s> → <span class="acc">{fmt(ta)}</span></b><small>{it.unit}</small></div>
                {it.metrics.map((m) => <div><b class="mono">{m.v}</b><small>{m.l}</small></div>)}
              </div>
            </div>

            <div class="p-r">
              <div class="bars">
                {[[c.before, it.before, tb, false], [c.after, it.after, ta, true]].map(([lab, steps, tot, isAfter]) => (
                  <div class="bar-row">
                    <span class={`mono k${isAfter ? ' acc' : ''}`}>{lab}</span>
                    <div class="track">
                      {(steps as typeof it.before).map((s) => (
                        <i class={`seg ${s.a ? 'a' : 'h'}`} style={`--w:${(s.m / tb) * 100}%`} data-cursor={`${s.s} · ${fmt(s.m)} ${c.min}`}></i>
                      ))}
                    </div>
                    <span class={`mono v${isAfter ? ' acc' : ''}`}>{fmt(tot as number)}</span>
                  </div>
                ))}
                <div class="legend mono"><span><i class="sw a"></i>{c.agent}</span><span><i class="sw h"></i>{c.human}</span></div>
              </div>
              <details class="steps">
                <summary>{c.showSteps}</summary>
                <div class="cols">
                  <ol class="list before">{it.before.map((s) => <li><span>{s.s}</span><span class="mono">{fmt(s.m)}</span></li>)}</ol>
                  <ol class="list after">{it.after.map((s) => <li class={s.a ? 'a' : ''}><span>{s.s}</span><span class="mono">{fmt(s.m)}</span></li>)}</ol>
                </div>
              </details>
            </div>
          </article>
        );
      })}
    </div>
    <p class="note">{c.note}</p>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sol [data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.sol [data-panel]')];
  tabs.forEach((t) => t.addEventListener('click', () => {
    const i = +t.dataset.tab!;
    tabs.forEach((x, k) => x.setAttribute('aria-selected', String(k === i)));
    panels.forEach((p, k) => p.classList.toggle('on', k === i));
  }));
</script>

<style>
  .tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 4px; background: var(--milk-2); border-radius: 12px; width: fit-content; max-width: 100%; }
  .tabs button {
    display: flex; gap: 10px; align-items: baseline; white-space: nowrap; border: 0; background: none; cursor: pointer;
    padding: 10px 16px; border-radius: 9px; font-size: 15px; color: var(--ink-2); transition: background .2s, color .2s;
  }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-selected="true"] { background: var(--paper); color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .red { font-size: 12px; color: var(--faint); }
  [aria-selected="true"] .red { color: var(--accent); }

  .panels { display: grid; margin-top: 40px; }
  .panel {
    grid-area: 1 / 1; display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 5vw, 80px); align-items: start;
    padding: clamp(28px, 4vw, 56px); background: var(--paper); border: 1px solid var(--line); border-radius: 16px;
    opacity: 0; visibility: hidden; transition: opacity .4s var(--ease), visibility .4s;
  }
  .panel.on { opacity: 1; visibility: visible; }
  .tagline { font-size: 14px; color: var(--muted); }
  .p-l { display: grid; gap: 28px; justify-items: start; }
  .metrics { width: 100%; display: grid; gap: 0; border-top: 1px solid var(--line-2); }
  .metrics div { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .metrics b { font-size: clamp(22px, 2.2vw, 28px); font-weight: 500; letter-spacing: -0.04em; }
  .metrics s { color: var(--faint); text-decoration-color: var(--accent); }
  .metrics small { color: var(--muted); font-size: 14px; text-align: right; }
  .acc { color: var(--accent); }

  .bars { display: grid; gap: 16px; }
  .bar-row { display: grid; grid-template-columns: 64px 1fr 48px; gap: 12px; align-items: center; }
  .k { font-size: 12px; text-transform: uppercase; color: var(--muted); }
  .v { text-align: right; font-size: 18px; }
  .track { display: flex; gap: 2px; height: 36px; }
  .seg { display: block; height: 100%; width: 0; border-radius: 3px; transition: width 1s var(--ease), filter .2s; }
  .panel.on .seg { width: var(--w); min-width: 4px; }
  .panel.on .bar-row + .bar-row .seg { transition-delay: .3s; }
  .seg.h { background: var(--ink-2); }
  .seg.a { background: var(--accent); }
  .seg:hover { filter: brightness(1.3); }
  .legend { display: flex; gap: 18px; font-size: 12px; color: var(--muted); padding-left: 76px; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
  .sw.a { background: var(--accent); } .sw.h { background: var(--ink-2); }

  .steps { margin-top: 20px; border-top: 1px solid var(--line); }
  .steps summary { list-style: none; cursor: pointer; padding: 14px 0 0; font-size: 14px; font-weight: 500; color: var(--ink-2); }
  .steps summary::-webkit-details-marker { display: none; }
  .steps summary::after { content: ' +'; color: var(--accent); }
  .steps[open] summary::after { content: ' −'; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 10px; }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--line-2); font-size: 14px; }
  .list .mono { color: var(--muted); font-size: 12px; }
  .before li span:first-child { color: var(--muted); text-decoration: line-through; text-decoration-color: color-mix(in oklab, var(--accent) 60%, transparent); }
  .after li.a span:first-child::before { content: '◆ '; color: var(--accent); font-size: 10px; }
  .note { margin-top: 28px; font-size: 13px; color: var(--faint); }

  @media (max-width: 920px) {
    .panel { grid-template-columns: 1fr; display: none; }
    .panel.on { display: grid; }
  }
  @media (max-width: 560px) {
    .cols { grid-template-columns: 1fr; }
    .bar-row { grid-template-columns: 48px 1fr 40px; gap: 8px; }
    .legend { padding-left: 56px; }
  }
</style>
