---
import type { Dict, Lang } from '../i18n/content';
import { lurl } from '../lib/url';
import HomeHead from './HomeHead.astro';
const { t, lang } = Astro.props as { t: Dict; lang: Lang };
const h = t.home.steps;
---
<section class="h-steps" id="how">
  <div class="wrap">
    <HomeHead eyebrow={h.eyebrow} title={h.title} lead={h.lead} href={lurl(lang, '/pricing/')} more={h.more} />
    <ol class="steps">
      {t.how.steps.map((s, i) => (
        <li class="reveal" style={`transition-delay:${i * 80}ms`}>
          <div class="s-top"><span class="node">{String(i + 1).padStart(2, '0')}</span><span class="time">{s.time}</span></div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Тёмная лента из четырёх этапов */
  .steps {
    list-style: none; margin: 0; padding: clamp(24px, 3vw, 40px); display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    background: var(--dark); color: var(--on-dark); border-radius: 32px; position: relative; overflow: hidden;
  }
  .steps::before {
    content: ''; position: absolute; right: -120px; top: -140px; width: 340px; height: 340px; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--orange) 26%, transparent), transparent 70%); pointer-events: none;
  }
  .steps li { position: relative; display: grid; align-content: start; gap: 12px; padding: 8px clamp(16px, 2vw, 28px); }
  .steps li + li { border-left: 1px solid var(--on-dark-line); }
  .s-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .node { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--peach); font-size: 14px; }
  .steps li:last-child .node { background: var(--peach); color: var(--dark); }
  .time { font-size: 13px; color: var(--on-dark-muted); }
  .steps h3 { margin-top: 8px; font-size: clamp(20px, 1.8vw, 24px); }
  .steps p { color: var(--on-dark-muted); font-size: 15px; line-height: 1.55; }
  @media (max-width: 960px) {
    .steps { grid-template-columns: 1fr 1fr; row-gap: 28px; }
    .steps li:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .steps li + li { border-left: 0; border-top: 1px solid var(--on-dark-line); padding-top: 24px; }
  }
</style>
