---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const p = t.problem;
---
<section class="problem">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2>{p.title}</h2>
    </div>
    <div class="stats">
      {p.stats.map((s, i) => (
        <article class="stat reveal" style={`transition-delay:${i * 80}ms`} tabindex="0">
          <b>{s.v}</b>
          <p class="stat-l">{s.l}</p>
          <p class="stat-fix"><span>→</span>{s.fix}</p>
        </article>
      ))}
    </div>
    <p class="note">{p.note}</p>
  </div>
</section>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-2); }
  .stat {
    padding: 32px 24px 36px 0; display: grid; gap: 14px; align-content: start;
    border-right: 1px solid var(--line); padding-left: 24px; position: relative; min-height: 300px;
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: 0; }
  .stat b { font-size: clamp(44px, 5vw, 72px); font-weight: 500; letter-spacing: -0.05em; line-height: 1; }
  .stat-l { color: var(--muted); }
  .stat-fix {
    margin-top: auto; display: flex; gap: 10px; font-size: 15px; color: var(--ink);
    padding-top: 16px; border-top: 1px dashed var(--line-2);
    opacity: .0; transform: translateY(8px); transition: opacity .4s, transform .4s var(--ease);
  }
  .stat-fix span { color: var(--accent); }
  .stat:hover .stat-fix, .stat:focus .stat-fix { opacity: 1; transform: none; }
  .stat:hover b { color: var(--accent); transition: color .3s; }
  .note { margin-top: 24px; font-size: 13px; color: var(--faint); }
  @media (hover: none) { .stat-fix { opacity: 1; transform: none; } }
  @media (max-width: 920px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat { border-bottom: 1px solid var(--line); min-height: 0; }
    .stat:nth-child(odd) { padding-left: 0; }
    .stat:nth-child(2n) { border-right: 0; }
  }
  @media (max-width: 520px) { .stats { grid-template-columns: 1fr; } .stat { padding-left: 0; border-right: 0; } }
</style>
