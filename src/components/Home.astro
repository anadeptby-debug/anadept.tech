---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Flow from './Flow.astro';
import Solutions from './Solutions.astro';
import How from './How.astro';
import Audit from './Audit.astro';
import Trust from './Trust.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import { dict, type Lang } from '../i18n/content';
import { url } from '../lib/url';

const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
---
<Base lang={lang} t={t}>
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Services t={t} />
    <Flow t={t} />
    <Solutions t={t} />
    <Audit t={t} />
    <How t={t} />
    <Trust t={t} />
    <Faq t={t} />
    <Contact t={t} />
  </main>
  <footer class="ftr">
    <div class="wrap ftr-in">
      <img class="logo" src={url('/brand/logo-center.png')} alt="Anadept" width="117" height="24" />
      <nav class="f-nav">{t.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
      <span>{t.footer.rights}</span>
    </div>
  </footer>
</Base>

<style>
  .ftr { padding: 40px 0 96px; color: var(--muted); font-size: 14px; }
  .ftr-in { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 28px; }
  .f-nav { display: flex; gap: 20px; flex-wrap: wrap; }
  .f-nav a:hover { color: var(--ink); }
  .logo { display: block; height: 24px; width: auto; }
</style>
