---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const c = t.contact;
---
<section class="contact" id="contact">
  <div class="wrap">
    <div class="box">
      <div class="glow" aria-hidden="true"></div>
      <div class="c-txt reveal">
        <span class="eyebrow">{c.eyebrow}</span>
        <h2>{c.title}</h2>
        <p class="alt">{c.alt}: <a href="https://t.me/anadept" data-cursor="Telegram">@anadept</a> · <a href="mailto:hello@anadept.by" data-cursor="Email">hello@anadept.by</a></p>
      </div>
      <form class="form reveal" data-ok={c.ok}>
        <label><span>{c.name}</span><input name="name" required autocomplete="name" /></label>
        <label><span>{c.contact}</span><input name="contact" required /></label>
        <label class="full"><span>{c.process}</span><textarea name="process" rows="2"></textarea></label>
        <button class="btn accent full" type="submit" data-magnetic>{c.send}<span class="arr">→</span></button>
        <p class="consent full">{c.consent}</p>
      </form>
    </div>
  </div>
</section>

<script>
  // TODO: подключить отправку (Telegram-бот / почта). Сейчас только состояние успеха.
  const form = document.querySelector<HTMLFormElement>('.contact .form')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    form.innerHTML = `<p class="ok">${form.dataset.ok}</p>`;
  });
  const box = document.querySelector<HTMLElement>('.contact .box')!;
  box.addEventListener('mousemove', (e) => {
    const r = box.getBoundingClientRect();
    box.style.setProperty('--mx', `${e.clientX - r.left}px`);
    box.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
</script>

<style>
  .box {
    position: relative; overflow: hidden; background: var(--dark); color: var(--on-dark);
    border-radius: 56px; padding: clamp(28px, 6vw, 72px);
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); --mx: 20%; --my: 20%;
  }
  .glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(520px circle at var(--mx) var(--my), color-mix(in oklab, var(--peach) 28%, transparent), transparent 60%); }
  .c-txt { position: relative; display: grid; gap: 24px; align-content: start; }
  .c-txt .eyebrow { color: #c7cad3; }
  .c-txt h2 { font-size: clamp(30px, 3.4vw, 46px); }
  .alt { color: var(--on-dark-muted); font-size: 15px; }
  .alt a { color: var(--on-dark); border-bottom: 1px solid #555c6b; }
  .form { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-content: start; }
  .form label { display: grid; gap: 6px; font-size: 13px; color: var(--on-dark-muted); }
  .full { grid-column: 1 / -1; }
  .form input, .form textarea {
    width: 100%; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--on-dark-line); background: #1a2030;
    color: var(--on-dark); font-size: 16px; outline: none; transition: border-color .2s; resize: vertical;
  }
  .form input:focus, .form textarea:focus { border-color: var(--peach); }
  .form .btn { justify-content: center; padding: 18px; }
  .consent { font-size: 12px; color: #7c8291; }
  .form :global(.ok) { font-size: 22px; grid-column: 1 / -1; }
  @media (max-width: 860px) { .box { grid-template-columns: 1fr; border-radius: 36px; } }
  @media (max-width: 480px) { .form { grid-template-columns: 1fr; } }
</style>
