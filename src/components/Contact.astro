---
import type { Dict, Lang } from '../i18n/content';
import { url } from '../lib/url';
const { t, lang = 'ru', title } = Astro.props as { t: Dict; lang?: Lang; title?: string };
const c = t.contact;
// Заявка уходит в воркер (/api/contact), он пересылает её в Telegram. В astro dev — через локальный wrangler dev на :8787
const api = import.meta.env.PUBLIC_CONTACT_API || (import.meta.env.DEV ? 'http://localhost:8787/api/contact' : url('/api/contact'));
---
<section class="contact" id="contact">
  <div class="wrap">
    <div class="box">
      <div class="glow" aria-hidden="true"></div>
      <div class="c-txt reveal">
        <h2>{title ?? c.title}</h2>
        <p class="alt">{c.alt}: <a href="https://t.me/anadept" data-cursor="Telegram">@anadept</a> · <a href="mailto:hello@anadept.by" data-cursor="Email">hello@anadept.by</a></p>
      </div>
      <form class="form reveal" data-contact={JSON.stringify({ api, lang, ok: c.ok, sending: c.sending, errors: c.errors })}>
        <label><span>{c.name}</span><input name="name" required maxlength="100" autocomplete="name" /></label>
        <label><span>{c.contact}</span><input name="contact" required minlength="3" maxlength="150" autocomplete="tel" /></label>
        <label class="full"><span>{c.process}</span><textarea name="process" rows="2" maxlength="1500"></textarea></label>
        {/* Ловушка для ботов: людям не видна, бот заполнит — заявка не уйдёт */}
        <label class="trap" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn accent full" type="submit" data-magnetic>{c.send}</button>
        <div class="c-err full" role="alert" hidden>
          <p class="c-err-msg"></p>
          <p class="c-err-alt"><a href="https://t.me/anadept">Telegram @anadept</a> <a href="mailto:hello@anadept.by">hello@anadept.by</a></p>
        </div>
        <p class="consent full">{c.consent}</p>
      </form>
    </div>
  </div>
</section>

<script>
  type Cfg = { api: string; lang: string; ok: string; sending: string; errors: Record<string, string> };
  document.querySelectorAll<HTMLFormElement>('.contact .form').forEach((form) => {
    const C = JSON.parse(form.dataset.contact!) as Cfg;
    const btn = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    const label = btn.textContent!;
    const err = form.querySelector<HTMLElement>('.c-err')!;
    const errMsg = err.querySelector<HTMLElement>('.c-err-msg')!;
    const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      btn.disabled = true;
      btn.textContent = C.sending;
      try {
        const res = await fetch(C.api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lang: C.lang, page: location.pathname,
            name: val('name'), contact: val('contact'), process: val('process'), website: val('website'),
          }),
        });
        const r = await res.json().catch(() => ({}));
        if (!res.ok || !r.ok) throw new Error(r.error || 'generic');
        // Успех показываем только после ответа воркера: заявка точно ушла в Telegram
        const ok = document.createElement('p');
        ok.className = 'ok';
        ok.setAttribute('role', 'status');
        ok.textContent = C.ok;
        form.replaceChildren(ok);
      } catch (x) {
        const code = x instanceof Error ? x.message : '';
        errMsg.textContent = C.errors[code] || C.errors.generic;
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  });

  const box = document.querySelector<HTMLElement>('.contact .box');
  box?.addEventListener('mousemove', (e) => {
    const r = box.getBoundingClientRect();
    box.style.setProperty('--mx', `${e.clientX - r.left}px`);
    box.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
</script>

<style>
  .box {
    position: relative; overflow: hidden; background: var(--dark); color: var(--on-dark);
    border-radius: 56px; padding: clamp(28px, 6vw, 72px);
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); --mx: 20%; --my: 20%;
  }
  .glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(520px circle at var(--mx) var(--my), color-mix(in oklab, var(--peach) 28%, transparent), transparent 60%); }
  .c-txt { position: relative; display: grid; gap: 24px; align-content: start; }
  .c-txt h2 { font-size: clamp(30px, 3.4vw, 46px); }
  .alt { color: var(--on-dark-muted); font-size: 15px; }
  .alt a { color: var(--on-dark); border-bottom: 1px solid var(--on-dark-rule); }
  .form { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-content: start; }
  .form label { display: grid; gap: 6px; font-size: 13px; color: var(--on-dark-muted); }
  .full { grid-column: 1 / -1; }
  .form input, .form textarea {
    width: 100%; padding: 12px 16px; border-radius: 14px; border: 1px solid var(--field-edge-dark); background: var(--dark-2);
    color: var(--on-dark); font-size: 16px; transition: border-color .2s; resize: vertical;
  }
  .form input:hover, .form textarea:hover { border-color: var(--on-dark-soft); }
  .form input:focus-visible, .form textarea:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .form .btn { justify-content: center; }
  .consent { font-size: 13px; color: var(--on-dark-faint); }
  .form :global(.ok) { font-size: 22px; grid-column: 1 / -1; }
  .form .btn:disabled { background: var(--dark-2); color: var(--on-dark-muted); box-shadow: inset 0 0 0 1px var(--field-edge-dark); cursor: progress; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .c-err { display: grid; gap: 6px; padding: 14px 16px; border-radius: 14px; background: var(--dark-2); box-shadow: inset 0 0 0 1px var(--peach); font-size: 15px; }
  .c-err[hidden] { display: none; }
  .c-err-alt { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .c-err-alt a { color: var(--on-dark); border-bottom: 1px solid var(--peach); }
  @media (max-width: 860px) { .box { grid-template-columns: 1fr; border-radius: 36px; } }
  @media (max-width: 480px) { .form { grid-template-columns: 1fr; } }
</style>
