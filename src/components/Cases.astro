---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const c = t.cases;
---
<section class="cases" id="cases">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{c.eyebrow}</span>
      <h2>{c.title}</h2>
    </div>
    <div class="tabs reveal" role="tablist">
      {c.items.map((it, i) => (
        <button type="button" role="tab" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-tab={i}>{it.tab}</button>
      ))}
    </div>
  </div>

  <div class="panels reveal">
    {c.items.map((it, i) => (
      <article class={`panel${i === 0 ? ' on' : ''}`} data-panel={i}>
        <div class="viz" data-cursor={c.detail}>
          <div class="viz-glow"></div>
          <div class="viz-in">
            <div class="vchips">{it.viz.chips.map((x) => <span class="tag">{x}</span>)}</div>
            <i class="varr">↓</i>
            <div class="vcard card">
              <span class="eyebrow">{it.viz.card}</span>
              <b>{it.viz.cardV}</b>
              <span class="tag">{it.viz.badge}</span>
            </div>
            <i class="varr">↓</i>
            <div class="vnums">
              {it.viz.nums.map((n) => <div class="card"><b>{n.v}</b><small>{n.l}</small></div>)}
            </div>
          </div>
        </div>
        <div class="txt">
          <span class="pill">{it.tag}</span>
          <h3>{it.title}</h3>
          <p class="lead">{it.text}</p>
          <ol class="steps">{it.steps.map((s) => <li>{s}</li>)}</ol>
          <span class="eyebrow">{c.resultsLabel}</span>
          <div class="results">
            {it.results.map((r) => <div><b>{r.v}</b><small>{r.l}</small></div>)}
          </div>
          <blockquote>{it.quote}</blockquote>
        </div>
      </article>
    ))}
  </div>
  <div class="wrap"><p class="note">{c.note}</p></div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.cases [data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.cases [data-panel]')];
  const show = (i: number) => {
    tabs.forEach((t, k) => t.setAttribute('aria-pressed', String(k === i)));
    panels.forEach((p, k) => p.classList.toggle('on', k === i));
  };
  tabs.forEach((t) => t.addEventListener('click', () => show(+t.dataset.tab!)));

  document.querySelectorAll<HTMLElement>('.cases .viz').forEach((v) => {
    v.addEventListener('mousemove', (e) => {
      const r = v.getBoundingClientRect();
      v.style.setProperty('--gx', `${e.clientX - r.left}px`);
      v.style.setProperty('--gy', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 10px; }
  .panels { margin-top: 40px; display: grid; }
  .panel {
    grid-area: 1 / 1; display: grid; grid-template-columns: 1fr 1fr; min-height: 760px;
    opacity: 0; visibility: hidden; transition: opacity .5s var(--ease), visibility .5s;
  }
  .panel.on { opacity: 1; visibility: visible; }
  .viz {
    position: relative; overflow: hidden; display: grid; place-items: center;
    background: linear-gradient(160deg, var(--paper), var(--milk-2)); --gx: 30%; --gy: 30%;
  }
  .viz-glow {
    position: absolute; inset: 0;
    background: radial-gradient(420px circle at var(--gx) var(--gy), color-mix(in oklab, var(--accent) 16%, transparent), transparent 65%);
  }
  .viz-in { position: relative; display: grid; justify-items: center; gap: 14px; width: min(440px, 86%); padding: 48px 0; }
  .vchips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .varr { font-style: normal; color: var(--faint); }
  .vcard { width: 100%; padding: 22px 24px; display: grid; gap: 6px; justify-items: start; border-radius: 18px; }
  .vcard b { font-size: 22px; font-weight: 500; }
  .vnums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; width: 100%; }
  .vnums .card { padding: 16px 8px; text-align: center; border-radius: 14px; box-shadow: none; }
  .vnums b { display: block; font-size: 30px; font-weight: 500; letter-spacing: -0.03em; }
  .vnums small { color: var(--muted); font-size: 13px; }
  .panel.on .vcard, .panel.on .vnums .card { animation: pop .6s var(--ease) both; }
  .panel.on .vnums .card:nth-child(2) { animation-delay: .08s; }
  .panel.on .vnums .card:nth-child(3) { animation-delay: .16s; }
  @keyframes pop { from { opacity: 0; transform: translateY(10px); } }

  .txt { padding: clamp(32px, 6vw, 80px) var(--gutter); display: grid; gap: 22px; align-content: center; justify-items: start; max-width: 720px; }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 10px; width: 100%; border-top: 1px solid var(--line); padding-top: 22px; }
  .steps li { counter-increment: s; display: flex; gap: 14px; color: var(--ink-2); }
  .steps li::before { content: counter(s, decimal-leading-zero); color: var(--faint); font-size: 13px; padding-top: 3px; min-width: 22px; }
  .results { display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; background: var(--ink); color: var(--milk); border-radius: 18px; overflow: hidden; }
  .results div { padding: 20px 10px; text-align: center; border-left: 1px solid #333; }
  .results div:first-child { border-left: 0; }
  .results b { display: block; font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -0.03em; }
  .results small { color: #9a9790; font-size: 13px; }
  blockquote { margin: 0; padding: 20px 24px; border-left: 3px solid var(--accent); background: var(--milk-2); border-radius: 0 16px 16px 0; font-size: 17px; }
  .note { margin-top: 20px; font-size: 13px; color: var(--faint); }
  @media (max-width: 920px) {
    .panel { grid-template-columns: 1fr; min-height: 0; display: none; }
    .panel.on { display: grid; }
  }
</style>
