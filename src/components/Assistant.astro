---
// Помощник: компактная строка внизу по центру → после первого сообщения уезжает вправо и становится окном чата →
// свёрнутый чат превращается в круглую кнопку в углу. Ответы ИИ по базе знаний (/api/chat в воркере).
import type { Dict, Lang } from '../i18n/content';
import { url } from '../lib/url';
const { t, lang } = Astro.props as { t: Dict; lang: Lang };
const a = t.assistant;
const api = import.meta.env.PUBLIC_CHAT_API || (import.meta.env.DEV ? 'http://localhost:8787/api/chat' : url('/api/chat'));
const cfg = { api, lang, greeting: a.greeting, thinking: a.thinking, errors: a.errors };
const icon = url('/brand/mark-white.png'); // белый знак на прозрачном фоне — внутри тёмного круга
---
<div class="asst" data-asst={JSON.stringify(cfg)}>
  <button type="button" class="a-launch" aria-label={a.title}>
    <img src={icon} alt="" width="24" height="19" />
    <span class="a-dot" aria-hidden="true"></span>
  </button>

  <div class="a-win">
    <header class="a-head">
      <span class="a-title"><span class="a-ava sm"><img src={icon} alt="" width="13" height="10" /></span>{a.title}</span>
      <span class="a-tools">
        <button type="button" class="a-clear">{a.clear}</button>
        <button type="button" class="a-close" aria-label={a.close}><i></i></button>
      </span>
    </header>
    <div class="a-log" role="log" aria-live="polite"></div>
    <p class="a-note">{a.note}</p>

    <div class="a-chips">
      {a.chips.map((c) => <button type="button" class="a-chip">{c}</button>)}
    </div>

    <form class="a-bar" autocomplete="off">
      <label class="sr" for="a-input">{a.placeholder}</label>
      <span class="a-ava" aria-hidden="true"><img src={icon} alt="" width="16" height="13" /></span>
      <input id="a-input" name="q" maxlength="800" placeholder={a.placeholder} enterkeyhint="send" />
      <button type="submit" class="a-send" aria-label={a.send}><i></i></button>
    </form>
  </div>
</div>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const root = document.querySelector<HTMLElement>('.asst')!;
  const C = JSON.parse(root.dataset.asst!) as { api: string; lang: string; greeting: string; thinking: string; errors: Record<string, string> };
  const log = root.querySelector<HTMLElement>('.a-log')!;
  const form = root.querySelector<HTMLFormElement>('.a-bar')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const sendBtn = form.querySelector<HTMLButtonElement>('.a-send')!;
  const KEY = `anadept-chat-${C.lang}`;

  // Диалог живёт в sessionStorage: переход по ссылке из ответа не сбрасывает разговор
  let state: { msgs: Msg[]; open: boolean } = { msgs: [], open: false };
  try { state = { ...state, ...JSON.parse(sessionStorage.getItem(KEY) || '{}') }; } catch {}
  const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
  let busy = false;

  // Режимы: bar — строка по центру (диалога нет); chat — окно справа; mini — круглая кнопка справа
  function mode() {
    const m = !state.msgs.length ? 'bar' : state.open ? 'chat' : 'mini';
    root.dataset.mode = m;
    if (m === 'chat') requestAnimationFrame(scroll);
  }

  // Безопасная разметка: экранируем всё, затем разрешаем ссылки на сайт / Telegram / почту и **жирный**
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  function md(text: string) {
    let h = esc(text);
    h = h.replace(/\[([^\]]{1,80})\]\(((?:\/[\w\-/#.]*)|(?:https:\/\/t\.me\/[\w]+)|(?:mailto:[\w.+\-]+@[\w.\-]+))\)/g,
      (_, label, href) => `<a href="${href}"${href.startsWith('https') ? ' target="_blank" rel="noopener"' : ''}>${label}</a>`);
    h = h.replace(/\*\*([^*]{1,120})\*\*/g, '<b>$1</b>');
    const lines = h.split(/\n+/).map((l) => l.trim()).filter(Boolean);
    let out = ''; let inList = false;
    for (const l of lines) {
      const m = l.match(/^(?:[-•*]|\d+[.)])\s+(.*)/);
      if (m) { if (!inList) { out += '<ul>'; inList = true; } out += `<li>${m[1]}</li>`; }
      else { if (inList) { out += '</ul>'; inList = false; } out += `<p>${l}</p>`; }
    }
    return inList ? out + '</ul>' : out;
  }

  function bubble(role: 'user' | 'assistant' | 'err', text: string) {
    const el = document.createElement('div');
    el.className = `a-msg ${role}`;
    if (role === 'user') el.textContent = text; else el.innerHTML = md(text);
    log.append(el);
    return el;
  }
  const scroll = () => { log.scrollTop = log.scrollHeight; };

  function render() {
    log.replaceChildren();
    bubble('assistant', C.greeting);
    state.msgs.forEach((m) => bubble(m.role, m.content));
  }

  function setOpen(v: boolean) { state.open = v; save(); mode(); if (v) input.focus({ preventScroll: true }); }

  async function ask(text: string) {
    text = text.trim();
    if (!text || busy) return;
    busy = true; sendBtn.disabled = true;
    state.msgs.push({ role: 'user', content: text });
    state.open = true; save();
    bubble('user', text);
    mode(); // первое сообщение: строка уезжает вправо и становится окном чата
    const typing = bubble('assistant', '');
    typing.classList.add('typing');
    typing.innerHTML = `<span></span><span></span><span></span><em class="sr">${C.thinking}</em>`;
    scroll();
    try {
      const res = await fetch(C.api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang: C.lang, page: location.pathname, messages: state.msgs.slice(-10) }),
      });
      const r = await res.json();
      if (!res.ok || r.error) throw new Error(r.error || 'generic');
      typing.remove();
      state.msgs.push({ role: 'assistant', content: r.reply }); save();
      bubble('assistant', r.reply);
      if (root.dataset.mode === 'mini') root.classList.add('unread');
    } catch (e) {
      typing.remove();
      bubble('err', C.errors[(e as Error).message] || C.errors.generic);
      if (!input.value) input.value = text;
      state.msgs.pop(); save(); // неудачный вопрос не уходит в историю — его можно отправить снова
    } finally {
      busy = false; sendBtn.disabled = false;
      scroll();
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; ask(v); });
  root.querySelectorAll<HTMLButtonElement>('.a-chip').forEach((b) =>
    b.addEventListener('pointerdown', (e) => { e.preventDefault(); ask(b.textContent || ''); }));
  root.querySelector('.a-launch')!.addEventListener('click', () => { root.classList.remove('unread'); setOpen(true); });
  root.querySelector('.a-close')!.addEventListener('click', () => setOpen(false));
  root.querySelector('.a-clear')!.addEventListener('click', () => { state = { msgs: [], open: false }; save(); render(); mode(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.dataset.mode === 'chat') setOpen(false); });
  // Переход по ссылке из ответа: на новой странице чат свёрнут в кнопку, чтобы было видно страницу
  log.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href^="/"]')) { state.open = false; save(); } });

  render();
  mode();
  requestAnimationFrame(() => root.classList.add('ready')); // анимации включаем после первой отрисовки
</script>

<style>
  .asst {
    --gap: 20px;
    --w: 400px;
    position: fixed; z-index: 60; bottom: var(--gap);
    left: 50%; transform: translateX(-50%); width: min(440px, calc(100% - 24px));
  }
  .asst.ready { transition: left .45s var(--ease), width .45s var(--ease), transform .45s var(--ease); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Окно (в режиме строки — просто карточка со строкой ввода) */
  .a-win {
    display: flex; flex-direction: column; padding: 5px;
    background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 22px;
    box-shadow: 0 2px 6px rgba(18,23,34,.06), 0 18px 48px -16px rgba(18,23,34,.35);
  }
  .a-head, .a-log, .a-note { display: none; }

  /* Режим «чат»: окно справа внизу */
  [data-mode="chat"], [data-mode="mini"] { left: calc(100% - var(--gap)); transform: translateX(-100%); }
  [data-mode="chat"] { width: min(var(--w), calc(100% - 24px)); }
  [data-mode="chat"] .a-win { height: min(600px, calc(100dvh - 2 * var(--gap))); padding: 6px; }
  [data-mode="chat"] .a-head { display: flex; }
  [data-mode="chat"] .a-log { display: flex; }
  [data-mode="chat"] .a-note { display: block; }
  .ready[data-mode="chat"] .a-win { animation: a-in .35s var(--ease); }
  @keyframes a-in { from { opacity: .6; transform: translateY(10px); } }

  /* Режим «кнопка»: круг в углу */
  [data-mode="mini"] { width: 56px; }
  [data-mode="mini"] .a-win { display: none; }
  .a-launch { display: none; }
  [data-mode="mini"] .a-launch {
    position: relative; display: grid; place-items: center; width: 56px; height: 56px; border: 0; border-radius: 50%;
    background: var(--dark); cursor: pointer; box-shadow: 0 14px 34px -10px rgba(18,23,34,.55); transition: transform .25s var(--ease);
  }
  .a-launch:hover { transform: scale(1.06); }
  .a-dot { position: absolute; top: 4px; right: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--peach); border: 2px solid var(--dark); display: none; }
  .unread .a-dot { display: block; }

  .a-head { justify-content: space-between; align-items: center; gap: 12px; padding: 4px 4px 8px 6px; border-bottom: 1px solid var(--line); }
  .a-title { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .a-tools { display: inline-flex; align-items: center; gap: 2px; }
  .a-clear { border: 0; background: none; padding: 6px 10px; border-radius: 999px; font-size: 12px; color: var(--muted); cursor: pointer; }
  .a-clear:hover { background: var(--milk-2); color: var(--ink); }
  .a-close { position: relative; width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--milk-2); cursor: pointer; }
  .a-close i::before { content: ''; position: absolute; left: 50%; top: 45%; width: 8px; height: 8px; border: solid var(--ink); border-width: 0 1.5px 1.5px 0; transform: translate(-50%, -50%) rotate(45deg); }

  .a-log { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; flex-direction: column; gap: 10px; padding: 14px 4px; }
  .a-log :global(.a-msg) { max-width: 88%; padding: 9px 13px; border-radius: 16px; font-size: 14.5px; line-height: 1.5; overflow-wrap: anywhere; }
  .a-log :global(.a-msg.assistant), .a-log :global(.a-msg.err) { align-self: flex-start; background: var(--milk-2); border-bottom-left-radius: 5px; }
  .a-log :global(.a-msg.user) { align-self: flex-end; background: var(--dark); color: var(--on-dark); border-bottom-right-radius: 5px; white-space: pre-wrap; }
  .a-log :global(.a-msg.err) { background: var(--accent-soft); color: color-mix(in oklab, var(--accent) 70%, var(--ink)); }
  .a-log :global(.a-msg p + p), .a-log :global(.a-msg p + ul), .a-log :global(.a-msg ul + p) { margin-top: 6px; }
  .a-log :global(.a-msg ul) { margin: 4px 0 0; padding-left: 18px; }
  .a-log :global(.a-msg a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .a-log :global(.a-msg.typing) { display: inline-flex; gap: 4px; padding: 13px 15px; }
  .a-log :global(.a-msg.typing span) { width: 6px; height: 6px; border-radius: 50%; background: var(--faint); animation: dot 1s infinite; }
  .a-log :global(.a-msg.typing span:nth-child(2)) { animation-delay: .15s; }
  .a-log :global(.a-msg.typing span:nth-child(3)) { animation-delay: .3s; }
  @keyframes dot { 0%, 80%, 100% { opacity: .3; transform: none; } 40% { opacity: 1; transform: translateY(-3px); } }
  .a-note { padding: 0 6px 6px; font-size: 11px; color: var(--faint); }

  /* Подсказки: в режиме строки — только когда поле в фокусе */
  .a-chips { display: none; flex-wrap: wrap; gap: 6px; padding: 4px 4px 8px; }
  [data-mode="bar"] .a-win:focus-within .a-chips { display: flex; }
  .a-chip { padding: 5px 11px; border: 1px solid var(--line-2); border-radius: 999px; background: #fff; font-size: 12.5px; color: var(--ink-2); cursor: pointer; transition: border-color .2s, color .2s; }
  .a-chip:hover { border-color: var(--ink); color: var(--ink); }

  /* Строка ввода */
  .a-bar { display: flex; align-items: center; gap: 8px; padding: 3px 3px 3px 4px; border-radius: 17px; background: var(--paper); border: 1px solid var(--line); transition: border-color .2s, background .2s; }
  .a-bar:focus-within { border-color: var(--line-2); background: #fff; }
  .a-ava { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--dark); }
  .a-ava.sm { width: 24px; height: 24px; }
  .a-ava img, .a-launch img { display: block; height: auto; transform: translateY(-1px); }
  .a-bar input { flex: 1; min-width: 0; height: 36px; border: 0; background: none; outline: none; font-size: 15px; }
  .a-bar input::placeholder { color: var(--faint); }
  .a-send { flex: none; position: relative; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--peach); cursor: pointer; transition: background .2s, opacity .2s; }
  .a-send:hover { background: var(--peach-hover); }
  .a-send:disabled { opacity: .5; cursor: default; }
  .a-send i { position: absolute; left: 50%; top: 50%; width: 2px; height: 13px; background: var(--dark); transform: translate(-50%, -40%); }
  .a-send i::after { content: ''; position: absolute; left: 50%; top: -1px; width: 7px; height: 7px; border: solid var(--dark); border-width: 2px 0 0 2px; transform: translateX(-50%) rotate(45deg); }

  @media (max-width: 600px) {
    .asst { --gap: 10px; }
    [data-mode="bar"] { width: calc(100% - 20px); }
    [data-mode="chat"] { width: calc(100% - 20px); }
    [data-mode="chat"] .a-win { height: min(560px, calc(100dvh - 90px)); }
    .a-bar input { font-size: 16px; } /* без автозума на iPhone */
  }
  @media (prefers-reduced-motion: reduce) { .asst.ready { transition: none; } .ready[data-mode="chat"] .a-win { animation: none; } }
</style>
