---
// Помощник: строка ввода внизу экрана на всех страницах, ответы ИИ по базе знаний (/api/chat в воркере)
import type { Dict, Lang } from '../i18n/content';
import { url } from '../lib/url';
const { t, lang } = Astro.props as { t: Dict; lang: Lang };
const a = t.assistant;
const api = import.meta.env.PUBLIC_CHAT_API || (import.meta.env.DEV ? 'http://localhost:8787/api/chat' : url('/api/chat'));
const cfg = { api, lang, greeting: a.greeting, thinking: a.thinking, errors: a.errors };
---
<div class="asst" data-asst={JSON.stringify(cfg)}>
  <section class="a-panel" aria-label={a.title}>
    <header class="a-head">
      <span class="a-title"><img src={url('/brand/icon-512.png')} alt="" width="22" height="22" />{a.title}</span>
      <span class="a-tools">
        <button type="button" class="a-clear">{a.clear}</button>
        <button type="button" class="a-close" aria-label={a.close}><i></i></button>
      </span>
    </header>
    <div class="a-log" role="log" aria-live="polite"></div>
    <p class="a-note">{a.note}</p>
  </section>

  <form class="a-bar" autocomplete="off">
    <label class="sr" for="a-input">{a.placeholder}</label>
    <span class="a-ava" aria-hidden="true"><img src={url('/brand/icon-512.png')} alt="" width="20" height="20" /></span>
    <input id="a-input" name="q" maxlength="800" placeholder={a.placeholder} enterkeyhint="send" />
    <button type="submit" class="a-send" aria-label={a.send}><i></i></button>
  </form>

  <div class="a-chips">
    {a.chips.map((c) => <button type="button" class="a-chip">{c}</button>)}
  </div>
</div>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const root = document.querySelector<HTMLElement>('.asst')!;
  const C = JSON.parse(root.dataset.asst!) as { api: string; lang: string; greeting: string; thinking: string; errors: Record<string, string> };
  const log = root.querySelector<HTMLElement>('.a-log')!;
  const form = root.querySelector<HTMLFormElement>('.a-bar')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const sendBtn = form.querySelector<HTMLButtonElement>('.a-send')!;
  const KEY = `anadept-chat-${C.lang}`;

  // Диалог живёт в sessionStorage: переход по ссылке из ответа не сбрасывает разговор
  let state: { msgs: Msg[]; open: boolean } = { msgs: [], open: false };
  try { state = { ...state, ...JSON.parse(sessionStorage.getItem(KEY) || '{}') }; } catch {}
  const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
  let busy = false;

  // Безопасная разметка: экранируем всё, затем разрешаем ссылки на сайт / Telegram / почту и **жирный**
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  function md(text: string) {
    let h = esc(text);
    h = h.replace(/\[([^\]]{1,80})\]\(((?:\/[\w\-/#.]*)|(?:https:\/\/t\.me\/[\w]+)|(?:mailto:[\w.+\-]+@[\w.\-]+))\)/g,
      (_, label, href) => `<a href="${href}"${href.startsWith('https') ? ' target="_blank" rel="noopener"' : ''}>${label}</a>`);
    h = h.replace(/\*\*([^*]{1,120})\*\*/g, '<b>$1</b>');
    const lines = h.split(/\n+/).map((l) => l.trim()).filter(Boolean);
    let out = ''; let inList = false;
    for (const l of lines) {
      const m = l.match(/^(?:[-•*]|\d+[.)])\s+(.*)/);
      if (m) { if (!inList) { out += '<ul>'; inList = true; } out += `<li>${m[1]}</li>`; }
      else { if (inList) { out += '</ul>'; inList = false; } out += `<p>${l}</p>`; }
    }
    return inList ? out + '</ul>' : out;
  }

  function bubble(role: 'user' | 'assistant' | 'err', text: string) {
    const el = document.createElement('div');
    el.className = `a-msg ${role}`;
    if (role === 'user') el.textContent = text; else el.innerHTML = md(text);
    log.append(el);
    return el;
  }
  const scroll = () => { log.scrollTop = log.scrollHeight; };

  function render() {
    log.replaceChildren();
    bubble('assistant', C.greeting);
    state.msgs.forEach((m) => bubble(m.role, m.content));
    root.classList.toggle('has-msgs', state.msgs.length > 0);
    scroll();
  }

  function setOpen(v: boolean) {
    state.open = v; save();
    root.classList.toggle('open', v);
    if (v) requestAnimationFrame(scroll);
  }

  async function ask(text: string) {
    text = text.trim();
    if (!text || busy) return;
    busy = true; sendBtn.disabled = true;
    state.msgs.push({ role: 'user', content: text }); save();
    root.classList.add('has-msgs');
    bubble('user', text);
    setOpen(true);
    const typing = bubble('assistant', '');
    typing.classList.add('typing');
    typing.innerHTML = `<span></span><span></span><span></span><em class="sr">${C.thinking}</em>`;
    scroll();
    try {
      const res = await fetch(C.api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang: C.lang, page: location.pathname, messages: state.msgs.slice(-10) }),
      });
      const r = await res.json();
      if (!res.ok || r.error) throw new Error(r.error || 'generic');
      typing.remove();
      state.msgs.push({ role: 'assistant', content: r.reply }); save();
      bubble('assistant', r.reply);
    } catch (e) {
      typing.remove();
      state.msgs.pop(); save(); // неудачный вопрос не уходит в историю — его можно отправить снова
      bubble('err', C.errors[(e as Error).message] || C.errors.generic);
      if (!input.value) input.value = text;
    } finally {
      busy = false; sendBtn.disabled = false;
      scroll();
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; ask(v); });
  root.querySelectorAll<HTMLButtonElement>('.a-chip').forEach((b) => b.addEventListener('click', () => ask(b.textContent || '')));
  input.addEventListener('focus', () => { if (state.msgs.length) setOpen(true); });
  root.querySelector('.a-close')!.addEventListener('click', () => setOpen(false));
  // Переход по ссылке из ответа: на новой странице панель свёрнута, чтобы было видно страницу; история сохраняется
  log.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href^="/"]')) { state.open = false; save(); } });
  root.querySelector('.a-clear')!.addEventListener('click', () => { state.msgs = []; save(); render(); root.classList.remove('has-msgs'); input.focus(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && state.open) setOpen(false); });
  document.addEventListener('pointerdown', (e) => { if (state.open && !root.contains(e.target as Node)) setOpen(false); });

  render();
  if (state.open && state.msgs.length) setOpen(true);
</script>

<style>
  .asst {
    position: fixed; left: 50%; bottom: 16px; z-index: 60; transform: translateX(-50%);
    width: min(620px, calc(100% - 24px)); padding: 8px;
    background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 26px;
    box-shadow: 0 2px 6px rgba(18,23,34,.06), 0 24px 60px -18px rgba(18,23,34,.35);
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Панель диалога: раскрывается над строкой ввода */
  .a-panel { display: none; }
  .open .a-panel { display: block; animation: a-in .3s var(--ease); }
  @keyframes a-in { from { opacity: 0; transform: translateY(8px); } }
  .a-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 4px 6px 8px 10px; border-bottom: 1px solid var(--line); }
  .a-title { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .a-title img { border-radius: 6px; }
  .a-tools { display: inline-flex; align-items: center; gap: 4px; }
  .a-clear { border: 0; background: none; padding: 6px 10px; border-radius: 999px; font-size: 13px; color: var(--muted); cursor: pointer; }
  .a-clear:hover { background: var(--milk-2); color: var(--ink); }
  .a-close { position: relative; width: 32px; height: 32px; border: 0; border-radius: 50%; background: var(--milk-2); cursor: pointer; }
  .a-close i::before { content: ''; position: absolute; left: 50%; top: 45%; width: 9px; height: 9px; border: solid var(--ink); border-width: 0 1.5px 1.5px 0; transform: translate(-50%, -50%) rotate(45deg); }

  .a-log { max-height: min(56vh, 480px); overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: 10px; padding: 14px 6px; }
  .a-log :global(.a-msg) { max-width: 88%; padding: 10px 14px; border-radius: 18px; font-size: 15px; line-height: 1.5; overflow-wrap: anywhere; }
  .a-log :global(.a-msg.assistant), .a-log :global(.a-msg.err) { align-self: flex-start; background: var(--milk-2); border-bottom-left-radius: 6px; }
  .a-log :global(.a-msg.user) { align-self: flex-end; background: var(--dark); color: var(--on-dark); border-bottom-right-radius: 6px; white-space: pre-wrap; }
  .a-log :global(.a-msg.err) { background: var(--accent-soft); color: color-mix(in oklab, var(--accent) 70%, var(--ink)); }
  .a-log :global(.a-msg p + p), .a-log :global(.a-msg p + ul), .a-log :global(.a-msg ul + p) { margin-top: 6px; }
  .a-log :global(.a-msg ul) { margin: 4px 0 0; padding-left: 18px; }
  .a-log :global(.a-msg a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .a-log :global(.a-msg.typing) { display: inline-flex; gap: 4px; padding: 14px 16px; }
  .a-log :global(.a-msg.typing span) { width: 6px; height: 6px; border-radius: 50%; background: var(--faint); animation: dot 1s infinite; }
  .a-log :global(.a-msg.typing span:nth-child(2)) { animation-delay: .15s; } .a-log :global(.a-msg.typing span:nth-child(3)) { animation-delay: .3s; }
  @keyframes dot { 0%, 80%, 100% { opacity: .3; transform: none; } 40% { opacity: 1; transform: translateY(-3px); } }
  .a-note { padding: 0 10px 8px; font-size: 12px; color: var(--faint); }

  /* Строка ввода */
  .a-bar { display: flex; align-items: center; gap: 8px; padding: 4px 4px 4px 6px; border-radius: 20px; background: var(--paper); border: 1px solid var(--line); transition: border-color .2s; }
  .a-bar:focus-within { border-color: var(--line-2); background: #fff; }
  .a-ava { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--dark); }
  .a-ava img { width: 20px; height: 20px; }
  .a-bar input { flex: 1; min-width: 0; height: 40px; border: 0; background: none; outline: none; font-size: 16px; }
  .a-bar input::placeholder { color: var(--faint); }
  .a-send { flex: none; position: relative; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--peach); cursor: pointer; transition: background .2s, opacity .2s; }
  .a-send:hover { background: var(--peach-hover); }
  .a-send:disabled { opacity: .5; cursor: default; }
  .a-send i { position: absolute; left: 50%; top: 50%; width: 2px; height: 14px; background: var(--dark); transform: translate(-50%, -40%); }
  .a-send i::after { content: ''; position: absolute; left: 50%; top: -1px; width: 8px; height: 8px; border: solid var(--dark); border-width: 2px 0 0 2px; transform: translateX(-50%) rotate(45deg); }

  /* Подсказки — пока диалог не начат */
  .a-chips { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; padding: 8px 4px 2px; }
  .has-msgs .a-chips { display: none; }
  .a-chip { padding: 6px 12px; border: 1px solid var(--line-2); border-radius: 999px; background: #fff; font-size: 13px; color: var(--ink-2); cursor: pointer; transition: border-color .2s, color .2s; }
  .a-chip:hover { border-color: var(--ink); color: var(--ink); }

  @media (max-width: 600px) {
    .asst { bottom: 8px; width: calc(100% - 16px); border-radius: 22px; padding: 6px; }
    .a-chips { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; scrollbar-width: none; padding: 6px 2px 0; }
    .a-chip { flex: none; }
    .a-log { max-height: 58vh; }
  }
  @media (prefers-reduced-motion: reduce) { .open .a-panel { animation: none; } .a-log :global(.a-msg.typing span) { animation: none; } }
</style>
