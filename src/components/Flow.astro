---
import type { Dict } from '../i18n/content';
const { t } = Astro.props as { t: Dict };
const f = t.flow;
---
<section class="flow" id="flow">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{f.eyebrow}</span>
      <h2>{f.title}</h2>
    </div>

    <ol class="chain reveal">
      {f.steps.map((s, i) => (
        <li class={i === 3 ? 'human' : i === f.steps.length - 1 ? 'end' : ''}>
          <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
          <b>{s.t}</b>
          <span class="d">{s.d}</span>
        </li>
      ))}
    </ol>

    <ul class="pr">
      {f.principles.map((p, i) => (
        <li class="reveal" style={`transition-delay:${i * 70}ms`}>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </li>
      ))}
    </ul>

    <p class="tools reveal">{f.tools}</p>
  </div>
</section>

<style>
  .chain { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); overflow: hidden; }
  .chain li { position: relative; display: grid; gap: 6px; align-content: start; padding: 28px 24px; border-left: 1px solid var(--line); }
  .chain li:first-child { border-left: 0; }
  .chain li:not(:last-child)::after {
    content: '→'; position: absolute; right: -9px; top: 26px; z-index: 1; width: 18px; height: 18px; display: grid; place-items: center;
    font-size: 12px; color: var(--accent); background: var(--paper);
  }
  .n { font-size: 12px; color: var(--faint); }
  .chain b { font-size: 17px; font-weight: 600; line-height: 1.3; }
  .chain .d { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .chain .human { background: var(--accent-soft); }
  .chain .human .n { color: var(--accent); }
  .chain .end b { color: var(--accent); }

  .pr { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .pr li { display: grid; gap: 8px; padding-top: 20px; border-top: 1.5px solid var(--dark); }
  .pr h3 { font-size: 20px; }
  .pr p { color: var(--muted); font-size: 16px; line-height: 1.6; }
  .tools { margin-top: 40px; font-size: 14px; color: var(--muted); }

  @media (max-width: 960px) {
    .chain { grid-template-columns: 1fr; }
    .chain li { border-left: 0; border-top: 1px solid var(--line); grid-template-columns: 32px 1fr; column-gap: 12px; padding: 18px 20px; }
    .chain li:first-child { border-top: 0; }
    .chain li .d { grid-column: 2; }
    .chain li:not(:last-child)::after { display: none; }
    .pr { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
