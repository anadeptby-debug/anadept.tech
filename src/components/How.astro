---
import type { Dict, Lang } from '../i18n/content';
import { lurl } from '../lib/url';
const { t, lang } = Astro.props as { t: Dict; lang: Lang };
const h = t.how;
---
<section class="how" id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{h.eyebrow}</span>
      <h2>{h.title}</h2>
    </div>

    <ol class="steps">
      {h.steps.map((s, i) => (
        <li class={`step reveal${s.hot ? ' hot' : ''}`} style={`transition-delay:${i * 70}ms`} data-cursor={s.hot ? h.hot : undefined}>
          <div class="s-top">
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="time mono">{s.time}</span>
          </div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <div class="get"><span>{h.getLabel}</span>{s.get}</div>
        </li>
      ))}
    </ol>

    {/* Цены не публикуем: стоимость считаем под задачу после бесплатной консультации */}
    <div class="cost reveal">
      <p>{h.pricing}</p>
      <a class="btn" href={lurl(lang, '/contact/')}>{h.pricingCta}<span class="arr">→</span></a>
    </div>

    <div class="extra-wrap reveal">
      <h3 class="extra-title">{h.extraTitle}</h3>
      <ul class="extra">
        {h.extra.map((e) => <li><b>{e.t}</b><span>{e.d}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .step {
    position: relative; display: grid; gap: 16px; align-content: start; grid-template-rows: auto auto 1fr auto;
    padding: 30px 28px; border-radius: var(--radius); background: var(--paper); border: 1px solid var(--line);
    transition: transform .4s var(--ease), box-shadow .4s, border-color .3s;
  }
  .step:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .step.hot { border-color: var(--peach); box-shadow: 0 0 0 3px var(--accent-soft); }
  .s-top { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
  .n { color: var(--accent); }
  .step h3 { font-size: 22px; }
  .step p { color: var(--muted); font-size: 16px; line-height: 1.6; }
  .get { display: grid; gap: 4px; padding-top: 14px; border-top: 1px dashed var(--line-2); font-size: 15px; line-height: 1.45; color: var(--ink); }
  .get span { font-size: 12px; color: var(--accent); font-weight: 600; }

  .cost {
    display: flex; justify-content: space-between; align-items: center; gap: 20px 40px; flex-wrap: wrap;
    margin-top: 24px; padding: clamp(24px, 3vw, 36px); border-radius: var(--radius); background: var(--dark); color: var(--on-dark);
  }
  .cost p { max-width: 620px; font-family: var(--font-head); font-size: clamp(19px, 1.8vw, 24px); font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }

  .extra-wrap { margin-top: clamp(40px, 5vw, 64px); }
  .extra-title { font-size: 22px; margin-bottom: 16px; }
  .extra { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .extra li { display: grid; gap: 6px; padding: 18px 4px 0; border-top: 1px solid var(--line-2); }
  .extra b { font-weight: 600; }
  .extra span { color: var(--muted); font-size: 15px; line-height: 1.55; }

  @media (max-width: 1000px) { .steps { grid-template-columns: 1fr 1fr; } .extra { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } .cost .btn { width: 100%; } }
</style>
