---
import type { Dict, Lang } from '../i18n/content';
import { lurl } from '../lib/url';
import HomeHead from './HomeHead.astro';
const { t, lang } = Astro.props as { t: Dict; lang: Lang };
const h = t.home.cases;
const c = t.solutions;
const href = lurl(lang, '/cases/');
const sum = (xs: { m: number }[]) => Math.round(xs.reduce((s, x) => s + x.m, 0) * 10) / 10;
const fmt = (n: number) => (lang === 'ru' ? String(n).replace('.', ',') : String(n));
---
<section class="h-cases" id="cases">
  <div class="wrap">
    <HomeHead eyebrow={h.eyebrow} title={h.title} lead={h.lead} href={href} more={h.more} />
    <div class="grid">
      {c.items.map((it, i) => {
        const tb = sum(it.before), ta = sum(it.after);
        const red = Math.round((1 - ta / tb) * 100);
        return (
          <a href={href} class="case reveal" style={`transition-delay:${(i % 2) * 70}ms`} data-cursor={t.home.more}>
            <div class="top"><span class="tag-line">{it.tag}</span><span class="red">−{red}%</span></div>
            <h3>{it.title}</h3>
            <div class="nums">
              <span><s>{fmt(tb)}</s> → <b>{fmt(ta)}</b></span>
              <small>{it.unit}</small>
            </div>
            <div class="bar" aria-hidden="true"><i style={`--w:${(ta / tb) * 100}%`}></i></div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .case {
    display: grid; gap: 18px; align-content: start; padding: 30px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    transition: transform .4s var(--ease), box-shadow .4s, border-color .3s;
  }
  .case:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--line-2); }
  .top { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; color: var(--muted); }
  .red { color: var(--accent); font-weight: 600; }
  .case h3 { font-size: clamp(19px, 1.7vw, 23px); line-height: 1.25; }
  .nums { display: flex; align-items: baseline; gap: 10px; }
  .nums span { font-family: var(--font-head); font-size: 26px; font-weight: 500; letter-spacing: -.04em; }
  .nums s { color: var(--faint); text-decoration-color: var(--accent); }
  .nums b { font-weight: 500; color: var(--accent); }
  .nums small { color: var(--muted); font-size: 14px; }
  .bar { height: 8px; border-radius: 999px; background: var(--dark); overflow: hidden; }
  .bar i { display: block; height: 100%; width: var(--w); min-width: 6px; border-radius: 999px; background: var(--accent); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .case { padding: 24px 22px; } }
</style>
